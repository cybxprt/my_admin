# Database
DATABASE_URL="postgresql://user:password@localhost:5432/my_admin"

# Application
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Router Configuration
ROUTER_ADDRESS=192.168.0.1
ROUTER_USERNAME=admin
ROUTER_PROTOCOL=http
ROUTER_API_ENDPOINT=/api

# Network Configuration
GATEWAY_ADDRESS=10.156.49.49
DNS_SERVER=8.8.8.8

# ADB Configuration
ADB_AVAILABLE=false
ADB_HOST=localhost
ADB_PORT=5037

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Logging
LOG_LEVEL=info

# Developer Mode
ENABLE_DEVELOPER_MODE=false
